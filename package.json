{
  "name": "goldkey-cleaner",
  "productName": "GoldKey Cleaner",
  "version": "1.0.0",
  "description": "A PC cleaning and optimization utility for Windows",
  "main": "main.js",
  "author": "rebucasrandy1986",
  "license": "MIT",
  "scripts": {
    "start": "set ELECTRON_RUN_AS_NODE=&& electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.goldkey.cleaner",
    "productName": "GoldKey Cleaner",
    "files": ["main.js", "preload.js", "src/**/*", "renderer/**/*"],
    "icon": "build/icon.png",
    "win": {
      "target": "nsis",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
